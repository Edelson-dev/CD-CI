# TMDB API
# Obtén tu key y read access token en: https://www.themoviedb.org/settings/api
# Copia este archivo a .env y pega tus credenciales (el archivo .env NO se versiona)
#
# El READ ACCESS TOKEN (JWT) es el que se envía como Bearer. Es la opción recomendada.
# La API KEY solo se usa como fallback (query param api_key=).
VITE_TMDB_API_READ_ACCESS_TOKEN=
VITE_TMDB_API_KEY=
